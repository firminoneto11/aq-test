# Copy the relevant keys into your existing .env without overwriting it.
# Generate independent secrets; URL-encode the database password in DB_SERVER.
POSTGRES_USER=interviewer
POSTGRES_DB=interviewer
POSTGRES_PASSWORD=
DB_DRIVER=asyncpg
DB_SERVER=postgresql+driver://interviewer:URL_ENCODED_PASSWORD@db:5432/interviewer
JWT_SECRET=
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173"]

# Media/signaling: project URL, key and secret from LiveKit Cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Inference provider keys; never expose these as VITE_* variables.
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
INTERVIEW_LLM_MODEL=openai/gpt-6-luna
INTERVIEW_PLANNER_MODEL=openai/gpt-6-luna
DEEPGRAM_MODEL=nova-3
ELEVEN_MODEL=eleven_turbo_v2_5
ELEVEN_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
VOICE_MAX_ACTIVE=2
VOICE_LEASE_SECONDS=30
VOICE_HEARTBEAT_SECONDS=10
LLM_TIMEOUT_SECONDS=20
EVALUATION_TIMEOUT_SECONDS=75
